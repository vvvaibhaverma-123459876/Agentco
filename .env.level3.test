# ============================================================
# LEVEL_3 Functional Verification Test Environment
# ============================================================
# This file contains LOCAL TEST credentials only.
# DO NOT use for production.
# DO NOT commit this file if it contains real secrets.
# ============================================================

# Database Configuration (matches docker-compose.yml)
DATABASE_URL=postgresql://agentco:password@localhost:5432/agentco
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentco
POSTGRES_USER=agentco
POSTGRES_PASSWORD=password

# Node Environment
NODE_ENV=test
AGENTCO_ENV=test

# Autonomy Test Mode
AUTONOMY_TEST_MODE=true

# API Configuration
API_URL=http://localhost:3001/api/autonomy/run-level3-smoke

# Backend Server Configuration
BACKEND_PORT=3001
BACKEND_HOST=localhost

# Development Credentials (test-only)
RESOLUTION_SERVICE_PASSWORD=resolution-service-test-password

# Observability (test mode)
LOG_LEVEL=debug
ENABLE_METRICS=true

# Test Timeout
TEST_TIMEOUT_MS=120000
