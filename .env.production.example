# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# This file shows all REQUIRED environment variables for production deployment.
# Copy to .env.production and fill in real values from secure secret store.
# NEVER commit actual secrets to version control.
# =============================================================================

# ===== CORE ENVIRONMENT =====
NODE_ENV=production
AGENTCO_ENV=production
PORT=3001
HOST=0.0.0.0

# ===== DATABASE =====
# REQUIRED: PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Must use TLS in production (add ?sslmode=require for AWS RDS, etc.)
DATABASE_URL=postgresql://agentco:CHANGE_ME_REQUIRED@postgres.example.com:5432/agentco_prod?sslmode=require

# ===== MESSAGE QUEUE =====
# REQUIRED: Kafka brokers for event streaming
KAFKA_BROKERS=kafka1.example.com:9092,kafka2.example.com:9092,kafka3.example.com:9092

# ===== SECURITY: SECRETS =====
# CRITICAL: All of these MUST be generated in production
# Use a secrets management system (Vault, AWS Secrets Manager, etc.)
# NEVER use dev defaults like "dev_key_v1"

# API authentication secret (minimum 32 random bytes, hex-encoded)
AGENTCO_API_KEY=CHANGE_ME_REQUIRED_32_RANDOM_BYTES_HEX

# JWT signing secret (minimum 32 random bytes, hex-encoded)
JWT_SECRET=CHANGE_ME_REQUIRED_32_RANDOM_BYTES_HEX

# API key secret for internal services (minimum 32 random bytes)
API_KEY_SECRET=CHANGE_ME_REQUIRED_32_RANDOM_BYTES_HEX

# Service-to-service authentication (minimum 32 random bytes)
SERVICE_IDENTITY_SECRET=CHANGE_ME_REQUIRED_32_RANDOM_BYTES_HEX

# ===== SECRET MANAGEMENT (VAULT) =====
# If using HashiCorp Vault for dynamic secrets
VAULT_ADDR=https://vault.example.com
VAULT_ROLE_ID=CHANGE_ME_REQUIRED
VAULT_SECRET_ID=CHANGE_ME_REQUIRED

# ===== OBSERVABILITY =====
# OpenTelemetry exporter endpoint (e.g., Datadog, New Relic, Grafana Tempo)
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com:443

# Prometheus metrics enabled
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ===== CORS & NETWORK =====
# Allowed origins for frontend (comma-separated if multiple)
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com,https://dashboard.example.com

# ===== RATE LIMITING & PROTECTION =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ===== AUDIT & COMPLIANCE =====
# Require audit logging for all writes
AUDIT_LOGGING_REQUIRED=true

# ===== GOVERNANCE & SAFETY ENFORCEMENT =====
# CRITICAL: All of these MUST be true in production
# These enforce the 7 non-negotiable safety rules

# Emergency shutdown capability
EMERGENCY_SHUTDOWN_ENABLED=true

# Emergency trust freeze (blocks trust policy changes)
EMERGENCY_TRUST_FREEZE_ENABLED=true

# Protected surface enforcement (blocks calibration/resolver mutations)
PROTECTED_SURFACE_ENFORCEMENT=true

# RBAC enforcement (role-based access control)
RBAC_ENFORCEMENT=true

# Calibration mutation blocking (rule: no direct calibration changes)
CALIBRATION_MUTATION_BLOCK=true

# Self-modification validation (rule: candidates can't modify themselves)
SELF_MOD_VALIDATION_REQUIRED=true

# Trust policy canary requirement (rule: all trust changes are canary-gated)
TRUST_POLICY_CANARY_REQUIRED=true

# ===== FEATURE FLAGS (Production) =====
# These should all be ENABLED in production
FEATURE_AUTONOMY_ENABLED=true
FEATURE_LEARNING_ENABLED=true
FEATURE_GOVERNANCE_ENABLED=true
FEATURE_CIVILIZATION_ENABLED=true

# ===== BACKUP & DISASTER RECOVERY =====
# S3 bucket for backups (must be encrypted at rest)
BACKUP_S3_BUCKET=agentco-prod-backups-encrypted
BACKUP_RETENTION_DAYS=30

# ===== LOGGING =====
LOG_LEVEL=info
LOG_FORMAT=json

# ===== TIMEOUT CONFIGURATION =====
# Database query timeout
DB_QUERY_TIMEOUT_MS=30000

# Request timeout
REQUEST_TIMEOUT_MS=60000

# ===== TLS/MTLS =====
# For service-to-service communication
TLS_ENABLED=true
TLS_CERT_PATH=/etc/secrets/tls/server.crt
TLS_KEY_PATH=/etc/secrets/tls/server.key
TLS_CA_PATH=/etc/secrets/tls/ca.crt

# =============================================================================
# VALIDATION NOTES
# =============================================================================
# Production startup will FAIL if:
# - Any CHANGE_ME_REQUIRED value is still set
# - DATABASE_URL is not production-like (no localhost, no default passwords)
# - Any governance enforcement flag is false
# - Required secrets are missing or too short
# - AGENTCO_ENV is not 'production'
#
# These checks are intentional and non-negotiable.
# =============================================================================
