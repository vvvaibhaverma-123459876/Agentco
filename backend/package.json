{
  "name": "@agentco/backend",
  "version": "1.0.0",
  "description": "AgentCo API Layer \u2014 Node.js + Fastify",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=/integration/ --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:e2e": "jest tests/e2e --runInBand",
    "test:all": "jest --runInBand",
    "smoke:durable": "npm run build && KAFKA_RETRIES=0 KAFKAJS_NO_PARTITIONER_WARNING=1 node dist/cli/smoke-durable-execution.js",
    "db:migrate": "ts-node src/db/migrate.ts",
    "lint": "eslint src --ext .ts",
    "agentco:supervised-free-run": "ts-node src/cli/supervised-free-run.ts",
    "agentco:longitudinal-learning": "ts-node src/cli/run-longitudinal-learning.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "ioredis": "^5.3.2",
    "kafkajs": "^2.2.4",
    "openai": "^4.52.7",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3",
    "uuid": "^11.1.0",
    "winston": "^3.19.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
