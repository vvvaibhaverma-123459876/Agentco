{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentco.local/schemas/real_provider_campaign_authorization.schema.json",
  "title": "AgentCo Real Provider Campaign Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign_id",
    "source_commit",
    "source_tree",
    "protocol_version",
    "genesis_version",
    "provider",
    "model",
    "endpoint",
    "approved_domains",
    "planned_case_count",
    "maximum_calls",
    "maximum_tokens",
    "maximum_cost_usd",
    "timeout_seconds",
    "retry_policy",
    "concurrency",
    "authorized_operator",
    "authorization_timestamp",
    "authorization_expiry",
    "approved_evidence_destination",
    "non_claims",
    "limitations",
    "signature_required"
  ],
  "properties": {
    "campaign_id": {"type": "string"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "protocol_version": {"type": "string"},
    "genesis_version": {"type": "string"},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "endpoint": {"type": "string"},
    "approved_domains": {"type": "array", "items": {"type": "string"}},
    "planned_case_count": {"type": "integer", "minimum": 1},
    "maximum_calls": {"type": "integer", "minimum": 1},
    "maximum_tokens": {"type": "integer", "minimum": 1},
    "maximum_cost_usd": {"type": "number", "minimum": 0},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_retries_per_case", "max_retries_total"],
      "properties": {
        "max_retries_per_case": {"type": "integer", "minimum": 0},
        "max_retries_total": {"type": "integer", "minimum": 0}
      }
    },
    "concurrency": {"type": "integer", "minimum": 1},
    "authorized_operator": {"type": "string", "minLength": 1},
    "authorization_timestamp": {"type": "string", "format": "date-time"},
    "authorization_expiry": {"type": "string", "format": "date-time"},
    "approved_evidence_destination": {"type": "string", "minLength": 1},
    "non_claims": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "signature_required": {"type": "boolean"},
    "signature": {"type": "string"}
  }
}
