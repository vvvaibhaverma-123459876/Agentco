{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentco.local/schemas/real_provider_execution_evidence.schema.json",
  "title": "AgentCo Real Provider Execution Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign_id",
    "case_id",
    "attempt_id",
    "source_commit",
    "source_tree",
    "provider",
    "model",
    "endpoint_identity",
    "request_timestamp",
    "response_timestamp",
    "latency_ms",
    "terminal_status",
    "redacted_request",
    "redacted_response",
    "token_usage",
    "cost",
    "retry_history",
    "timeout_history",
    "audit_references",
    "semantic_hash",
    "artifact_location"
  ],
  "properties": {
    "campaign_id": {"type": "string"},
    "case_id": {"type": "string"},
    "attempt_id": {"type": "string"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "provider": {"type": "string"},
    "model": {"type": ["string", "null"]},
    "endpoint_identity": {"type": "object"},
    "request_timestamp": {"type": "string", "format": "date-time"},
    "response_timestamp": {"type": "string", "format": "date-time"},
    "latency_ms": {"type": "number", "minimum": 0},
    "terminal_status": {
      "type": "string",
      "enum": ["completed", "failed", "timed_out", "denied", "evidence_unavailable", "evaluator_unavailable", "invalid_response", "infrastructure_failure"]
    },
    "redacted_request": {"type": "object"},
    "redacted_response": {"type": "object"},
    "provider_request_id": {"type": ["string", "null"]},
    "token_usage": {"type": "object"},
    "cost": {"type": "object"},
    "retry_history": {"type": "array"},
    "timeout_history": {"type": "array"},
    "evaluator_result": {"type": ["object", "null"]},
    "audit_references": {"type": "array"},
    "semantic_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_location": {"type": "string"}
  }
}
