# ============================================================
# AgentCo Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# LLM — Config-driven provider/model selection
#
# Every tier (frontier | standard | monitor | coder) resolves its own
# provider, base_url, api_key, and model via env vars.
# Per-tier vars take precedence over global vars.
#
# HOW TO SWITCH PROVIDERS (no code change required):
#   1. Set LLM_PROVIDER (+ LLM_API_KEY, LLM_BASE_URL) to change all tiers.
#   2. Or set LLM_PROVIDER_<TIER> to change one tier independently.
#
# HOW TO MIX PROVIDERS (e.g. Anthropic for frontier, OpenAI for everything else):
#   LLM_PROVIDER=openai
#   LLM_API_KEY=sk-openai-...
#   LLM_PROVIDER_FRONTIER=anthropic
#   LLM_API_KEY_FRONTIER=sk-ant-...
#   LLM_MODEL_FRONTIER=claude-haiku-4-5-20251001
# ------------------------------------------------------------

# --- Global fallback (applies to any tier without a per-tier override) ---

# Provider name: openai | ollama | anthropic | groq | together | fireworks |
#                openrouter | deepseek | mistral | anyscale
# All except "anthropic" use the OpenAI SDK with a custom base_url.
LLM_PROVIDER=ollama

# API key (required for all non-ollama providers)
LLM_API_KEY=ollama

# Base URL for the OpenAI-compatible endpoint (auto-set per provider if omitted)
LLM_BASE_URL=http://localhost:11434/v1

# Default model name (used when no per-tier LLM_MODEL_<TIER> is set)
LLM_MODEL_DEFAULT=qwen2.5:7b

# --- Per-tier overrides (each is optional; falls back to global above) ---
# Tiers: FRONTIER (ceo-agent), STANDARD (pm-agent, etc.), MONITOR (support-agent), CODER (coder-agent)

# LLM_PROVIDER_FRONTIER=anthropic
# LLM_API_KEY_FRONTIER=sk-ant-...
# LLM_BASE_URL_FRONTIER=                      # leave blank for Anthropic's default endpoint
# LLM_MODEL_FRONTIER=claude-haiku-4-5-20251001

# LLM_PROVIDER_STANDARD=openai
# LLM_API_KEY_STANDARD=sk-...
# LLM_BASE_URL_STANDARD=https://api.openai.com/v1
# LLM_MODEL_STANDARD=gpt-4o-mini

# LLM_PROVIDER_MONITOR=ollama
# LLM_API_KEY_MONITOR=ollama
# LLM_BASE_URL_MONITOR=http://localhost:11434/v1
# LLM_MODEL_MONITOR=qwen2.5:7b

# LLM_PROVIDER_CODER=groq
# LLM_API_KEY_CODER=gsk_...
# LLM_BASE_URL_CODER=https://api.groq.com/openai/v1
# LLM_MODEL_CODER=llama-3.1-70b-versatile

# --- Spend guardrail ---
# Hard cap on tokens per agent run; raises SpendCapExceeded + escalates if exceeded.
LLM_MAX_TOKENS_PER_RUN=100000
# Max LLM calls per minute per agent run
LLM_RATE_LIMIT_RPM=60

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# PostgreSQL connection string
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://agentco:password@localhost:5432/agentco

# Test DSN used by Python real-infra tests (civilization, reserve, evals/regression).
# Points at the same DB; test fixtures drop/recreate their own tables in isolation.
AGENTCO_TEST_DATABASE_URL=postgresql://agentco:password@localhost:5432/agentco

# ------------------------------------------------------------
# Cache / Pub-Sub
# ------------------------------------------------------------
# Redis connection string
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# Messaging / Event Streaming
# ------------------------------------------------------------
# Comma-separated list of Kafka broker addresses
KAFKA_BROKERS=localhost:9092

# Dev signing keys. These are refused when AGENTCO_ENV=production.
EVENT_BUS_SIGNING_KEY=dev-key-replace-in-production
EVENT_BUS_HMAC_KEY=dev-insecure-key

# ------------------------------------------------------------
# Vector Database (Pinecone)
# ------------------------------------------------------------
# API key from https://app.pinecone.io
PINECONE_API_KEY=

# Pinecone environment (e.g. us-east-1-aws, gcp-starter)
PINECONE_ENVIRONMENT=us-east-1-aws

# Name of the Pinecone index used for agent long-term memory
PINECONE_INDEX_NAME=agentco-memory

# ------------------------------------------------------------
# Secrets Management (HashiCorp Vault)
# ------------------------------------------------------------
# Address of the Vault server
VAULT_ADDR=http://localhost:8200

# Root or service-account token (use AppRole auth in production)
VAULT_TOKEN=<set-local-or-vault-token>

# Resolution service role password for local one-command launch.
# Production must override this.
RESOLUTION_SERVICE_PASSWORD=<set-local-resolution-service-password>

# ------------------------------------------------------------
# Auth & Security
# ------------------------------------------------------------
# Secret used to sign JWT access tokens — use a long random string
# Generate with: openssl rand -hex 64
JWT_SECRET=<generate-with-openssl-rand-hex-64>

# Minimal API-key auth for write endpoints. Production must override this.
AGENTCO_API_KEY=<set-local-agentco-api-key>

# Legacy Reserve HMAC signing key for dev credentials. Production must override
# or configure RESERVE_PRIVATE_KEY for Ed25519 credential signatures.
RESERVE_SIGNING_KEY=<set-local-reserve-signing-key>

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
# Runtime environment: development | test | staging | production
NODE_ENV=development

# Port the backend API server listens on
PORT=3001

# URL of the frontend (used for CORS and redirect URIs)
FRONTEND_URL=http://localhost:3000

# Logging verbosity: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# ------------------------------------------------------------
# Observability (OpenTelemetry)
# ------------------------------------------------------------
# OTLP HTTP endpoint for traces, metrics, and logs
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name reported in all telemetry signals
OTEL_SERVICE_NAME=agentco
